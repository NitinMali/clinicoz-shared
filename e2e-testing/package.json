{
  "name": "clinicoz-e2e-testing",
  "version": "1.0.0",
  "description": "Clinicoz Natural Language E2E Testing Engine",
  "main": "server.ts",
  "scripts": {
    "start": "ts-node server.ts",
    "start:tsx": "npx tsx server.ts",
    "docker:build": "docker compose -f docker-compose.dev.yml up --build",
    "docker:stop": "docker compose -f docker-compose.dev.yml down",
    "test": "jest",
    "test:properties": "jest --testPathPattern=properties"
  },
  "dependencies": {
    "@nestjs/bullmq": "^10.1.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/serve-static": "^4.0.0",
    "bullmq": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.3.0",
    "ioredis": "^5.3.0",
    "playwright": "^1.41.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "stagehand": "^1.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.3.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.0",
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
